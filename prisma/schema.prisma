generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Contact form submissions from the website
model ContactSubmission {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String
  phone     String?
  service   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_submissions")
}

// Newsletter subscribers
model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscribers")
}

// Projects portfolio
model Project {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  category    String
  client      String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("completed")
  imageUrl    String?
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("projects")
}

// Team members
model TeamMember {
  id        Int      @id @default(autoincrement())
  fullName  String
  position  String
  bio       String?
  imageUrl  String?
  email     String?
  phone     String?
  sortOrder Int       @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

// Service testimonials
model Testimonial {
  id        Int      @id @default(autoincrement())
  fullName  String
  company   String?
  position  String?
  content   String
  rating    Int      @default(5)
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}
