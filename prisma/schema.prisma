generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./db/custom.db"
}

// Admin users for the admin panel
model AdminUser {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  fullName  String
  role      String    @default("admin")
  isActive  Boolean   @default(true)
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("admin_users")
}

// Sessions for token-based authentication
model Session {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@map("sessions")
}

// Contact form submissions from the website
model ContactSubmission {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String
  phone     String?
  service   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_submissions")
}

// Newsletter subscribers
model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscribers")
}

// Service categories with services stored as JSON
model ServiceCategory {
  id          Int      @id @default(autoincrement())
  name        String
  icon        String
  color       String
  lightColor  String
  borderColor String
  services    String   @default("[]")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("service_categories")
}

// Site-wide settings (key-value store)
model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// Projects portfolio
model Project {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  category    String
  client      String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("completed")
  imageUrl    String?
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("projects")
}

// Team members
model TeamMember {
  id        Int      @id @default(autoincrement())
  fullName  String
  position  String
  bio       String?
  imageUrl  String?
  email     String?
  phone     String?
  sortOrder Int       @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

// Service testimonials
model Testimonial {
  id        Int      @id @default(autoincrement())
  fullName  String
  company   String?
  position  String?
  content   String
  rating    Int      @default(5)
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}
